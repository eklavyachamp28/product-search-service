{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": {
      "filter": {
        "product_synonyms": {
          "type": "synonym_graph",
          "synonyms": [
            "tv, television",
            "laptop, notebook",
            "phone, smartphone, mobile",
            "headphones, headset, earphones",
            "sneakers, trainers, running shoes"
          ]
        },
        "english_stemmer": { "type": "stemmer", "language": "light_english" }
      },
      "analyzer": {
        "product_index": {
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding", "english_stemmer"]
        },
        "product_search": {
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding", "product_synonyms", "english_stemmer"]
        }
      },
      "normalizer": {
        "lowercase_keyword": { "type": "custom", "filter": ["lowercase", "asciifolding"] }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "id":          { "type": "keyword" },
      "name": {
        "type": "text", "analyzer": "product_index", "search_analyzer": "product_search",
        "fields": {
          "suggest": { "type": "search_as_you_type", "max_shingle_size": 3 },
          "raw":     { "type": "keyword", "normalizer": "lowercase_keyword" }
        }
      },
      "description": { "type": "text", "analyzer": "product_index", "search_analyzer": "product_search" },
      "brand":       { "type": "keyword", "fields": { "text": { "type": "text", "analyzer": "product_index" } } },
      "category":    { "type": "keyword" },
      "price":       { "type": "scaled_float", "scaling_factor": 100 },
      "rating":      { "type": "half_float" },
      "reviewCount": { "type": "integer" },
      "inStock":     { "type": "boolean" },
      "tags":        { "type": "keyword", "normalizer": "lowercase_keyword" },
      "releasedOn":  { "type": "date", "format": "yyyy-MM-dd" }
    }
  }
}
